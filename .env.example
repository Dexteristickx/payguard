# PayPal Sandbox Credentials
# Get these from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=sandbox_client_id_placeholder
PAYPAL_CLIENT_SECRET=sandbox_client_secret_placeholder
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Server
PORT=3100
HOST=0.0.0.0

# Policy Defaults
POLICY_MAX_AMOUNT=50
POLICY_VELOCITY_LIMIT=3
POLICY_VELOCITY_WINDOW_MS=600000
POLICY_MIN_VENDOR_TRUST=70

# Telegram (Block 2 — leave blank for now)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
